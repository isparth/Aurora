# Aurora — environment variables
# Copy to .env.local and fill in what you need. Every variable is optional:
# the app runs fully without any of them, using free public services.

# ---------------------------------------------------------------------------
# Routing (drive times + route geometry for road-condition matching)
# ---------------------------------------------------------------------------
# "mapbox" | "osrm" | "estimate". Default: mapbox if MAPBOX_TOKEN is set, otherwise osrm.
# "estimate" never calls a routing service (straight-line distance × 1.35 at 65 km/h, marked as estimated).
ROUTING_PROVIDER=

# Mapbox Directions API token (server-side only, never sent to the browser).
MAPBOX_TOKEN=
# Process-wide cap on Mapbox routing calls per minute (protects your bill). Default 120.
ROUTING_MAX_PER_MINUTE=

# OSRM server. Defaults to the public demo server (https://router.project-osrm.org), which is
# rate-limited and has no SLA — self-host OSRM for production.
OSRM_BASE_URL=

# ---------------------------------------------------------------------------
# Optional camera analysis (supplementary evidence only)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible Chat Completions endpoint that accepts image input.
# Leave VISION_API_KEY empty to disable camera analysis entirely.
VISION_API_KEY=
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Optional overrides for public services
# ---------------------------------------------------------------------------
# Open-Meteo forecast API (e.g. a self-hosted instance or a commercial endpoint).
OPEN_METEO_BASE_URL=
# Photon geocoder used for place search (defaults to https://photon.komoot.io).
PHOTON_BASE_URL=
# MapLibre style URL for the map (public; defaults to OpenFreeMap "dark").
NEXT_PUBLIC_MAP_STYLE_URL=
